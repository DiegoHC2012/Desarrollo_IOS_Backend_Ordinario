  "item": [
    {
      "name": "Subjects",
      "item": [
        {
          "name": "Get All Subjects",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/subjects/{{institutionId}}/{{studentId}}"
          }
        },
        {
          "name": "Get Subject by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/subjects/{{institutionId}}/{{studentId}}/{{subjectId}}"
          }
        },
        {
          "name": "Create Subject",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Matemáticas\",\n  \"description\": \"Álgebra avanzada\",\n  \"teacher\": \"Juan Pérez\",\n  \"schedule\": \"Lunes 10:00\"\n}"
            },
            "url": "{{baseUrl}}/subjects/{{institutionId}}/{{studentId}}"
          }
        },
        {
          "name": "Update Subject",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Álgebra lineal actualizada\",\n  \"schedule\": \"Martes 12:00\"\n}"
            },
            "url": "{{baseUrl}}/subjects/{{institutionId}}/{{studentId}}/{{subjectId}}"
          }
        },
        {
          "name": "Delete Subject",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/subjects/{{institutionId}}/{{studentId}}/{{subjectId}}"
          }
        }
